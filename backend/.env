# ==========================================================
# growthos_backend/.env
# Must sit in the SAME FOLDER as main.py, named exactly ".env"
# (not "api.env") — that's the filename python-dotenv's
# load_dotenv() looks for automatically.
# After editing this file, fully STOP and RESTART main.py —
# env vars are only read once, when the process starts.
# ==========================================================

